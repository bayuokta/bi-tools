# Satu service principal untuk Fabric API, Power BI REST, Graph, dan XMLA.
# Program sync membaca environment lalu file ini (--env-file).
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
# Khusus screenshot TSD (identitas RLS untuk embed token)
RLS_USERNAME=
RLS_ROLES=
# Tujuan upload snapshot (program sync). Kosongkan bila tidak upload.
# Izin Graph aplikasi: Sites.Selected (disarankan) + grant untuk site tujuan.
SP_HOSTNAME=
SP_SITE_PATH=
SP_DRIVE_NAME=Documents
SP_FOLDER=
