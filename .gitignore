*.pbit

# Database lineage lokal dan kredensial (jangan di-commit)
*.db
*.db-journal
*.db-wal
*.db-shm
.env

# Cache screenshot TSD (data turunan; jangan di-commit)
TSD_assets/

# Database dan data lokal (jangan di-commit)
data/
outputs/
# Fixture uji tetap di-commit (bukan data runtime)
!tests/data/
!tests/data/**

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Hasil build paket (PyInstaller + Inno Setup)
build/
dist/
packaging/Output/

# Editor / OS
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# Berkas sementara
_probe_*.py
_pbir/
~$*.xlsx

# Hasil analisa semantic model (regenerate dari script)
Analisa_Semantic_Model_*.xlsx
